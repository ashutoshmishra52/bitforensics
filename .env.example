# Optional: archive alert exports to PostgreSQL (SQLite stays the working DB).
# Without this, exports still land in data/exports/ as CSV + PDF.

POSTGRES_URL=postgresql+psycopg://bitforensics:bitforensics@localhost:5432/bitforensics

